{
  "name": "sandbox-memo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "tsc -b && tsc -p functions && vite build",
    "preview": "pnpm build && wrangler pages dev dist --port 8788",
    "lint": "oxlint",
    "db:init:local": "wrangler d1 execute sandbox-memo --local --file schema.sql",
    "db:seed:local": "wrangler d1 execute sandbox-memo --local --file seed.sql",
    "db:init:remote": "wrangler d1 execute sandbox-memo --remote --file schema.sql",
    "deploy": "pnpm build && wrangler pages deploy dist"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.160.0"
  }
}
